# Parámetros externos para despliegue MANUAL. No se carga automáticamente en los scripts locales.
EMEDICAPP_MODE=MANUAL
EMEDICAPP_DB_URL=jdbc:postgresql://127.0.0.1:5432/emedicapp_manual
EMEDICAPP_DB_USER=emedicapp_manual_app
EMEDICAPP_DB_PASSWORD=
EMEDICAPP_DOCUMENTS_DIR=
EMEDICAPP_ADDRESS=127.0.0.1
EMEDICAPP_PORT=8082
EMEDICAPP_SECURE_COOKIES=true
EMEDICAPP_BUSINESS_ZONE=America/Argentina/Mendoza
EMEDICAPP_ADMIN_EMAIL=
EMEDICAPP_ADMIN_PASSWORD=
EMEDICAPP_PUBLIC_URL=
# Frontend independiente en GitHub Pages (origen exacto, sin ruta).
EMEDICAPP_ALLOWED_ORIGINS=https://jereprograma.github.io
# Base del frontend para enlaces de confirmacion/recuperacion; incluye la ruta del proyecto.
EMEDICAPP_EMAIL_BASE_URL=https://jereprograma.github.io/E-MEDICAPP/
# Solo al compilar el frontend para Pages; no contiene secretos.
VITE_BASE_PATH=/E-MEDICAPP/
# Opcional: origen HTTPS estable del backend. Si queda vacio, se configura desde la web.
VITE_API_BASE_URL=
SERVER_FORWARD_HEADERS_STRATEGY=NONE
EMEDICAPP_DOCUMENT_USER_QUOTA_BYTES=262144000
EMEDICAPP_DOCUMENT_TOTAL_QUOTA_BYTES=5368709120
EMEDICAPP_DOCUMENT_MIN_FREE_BYTES=1073741824
